#!/bin/sh

# m8r, in /srv/hyperion/m8r (see its README.md). Runs m8r's own command, m8r-cli, as the m8r
# user, with the settings and the secret that its units get. It runs itself with sudo.
#
#   m8r task link             print an access link, which works for 8 hours
#   m8r task link hours:72    ... for 72 hours
#   m8r task link once:true   ... one time only
#   m8r task tick             do now what the scheduler does every minute
#   m8r doctor                check the config and the database
#   m8r <command> [args]      any other command of m8r-cli: see `m8r --help`

set -eu

M8R=/srv/hyperion/m8r

if [ "$(id -u)" -ne 0 ]; then exec sudo "$0" "$@"; fi

# Export the KEY=value lines of the file $1, as systemd's EnvironmentFile= reads them for the
# units: no quotes, and # starts a comment only at the start of a line. A variable that is
# already set wins, e.g. LOG_LEVEL.
load_env() {
  [ -r "$1" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    key=${line%%=*}
    case $line in "#"* | ";"* | "$key") continue ;; esac
    case $key in "" | [0-9]* | *[!A-Za-z0-9_]*) continue ;; esac
    eval "given=\${$key+x}"
    if [ -n "$given" ]; then continue; fi
    # shellcheck disable=SC2163 # Exports KEY=value, as it reads.
    export "$line"
  done <"$1"
}

case "${1:-}" in
  "" | -h | help)
    sed -n '3,/^$/s/^# \{0,1\}//p' "$0"
    exit
    ;;
esac

load_env /etc/default/m8r
load_env "$M8R/.env"
cd "$M8R"
# runuser sets HOME and SHELL to m8r's own, as systemd does for the units.
exec runuser -u m8r -- "$M8R/target/release/m8r-cli" "$@"
