# Limit the guest networks' bandwidth; see /usr/local/sbin/guest-shaper.
[Unit]
Description=Guest network bandwidth limits
# systemd-networkd creates the guest networks' interfaces.
Wants=systemd-networkd.service
After=systemd-networkd.service

[Service]
ExecStart=/usr/local/sbin/guest-shaper run
ExecStopPost=/usr/local/sbin/guest-shaper stop
Restart=always

[Install]
WantedBy=multi-user.target
