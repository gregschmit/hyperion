# IPv4 uplink (Metronet): a static address in 209.173.223.176/29. The LAN shares it through NAT
# (see /etc/nftables.conf).
#
# To carry IPv6 on this uplink too (no wan6), set DHCP=ipv6 and IPv6AcceptRA=yes below, copy the
# [IPv6AcceptRA] and [DHCPv6] sections from 20-wan6.network, and change the LAN prefix in
# 20-lan.network to the one this ISP delegates. The wan6 files can stay.
[Match]
Name=wan4

[Network]
Address=209.173.223.178/29
IPv6AcceptRA=no

[Route]
Gateway=209.173.223.177
# Packets over a size limit are lost past this uplink, with no ICMP error to say so, which stalls
# TCP. The limit moves (1288 bytes one day, about 750 the next; see `mtu-test`), so stay well under
# it (nftables.conf fits forwarded TCP to this). It's on this route, not the link, so that mtu-test
# can still send bigger packets; only the gateway itself is reached by another route. Metronet's to
# fix: remove this when 1500 bytes get through.
MTUBytes=576

[Link]
# Don't hold up boot when the ISP is down; dnsmasq waits for network-online.target.
RequiredForOnline=no
