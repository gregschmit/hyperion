# LAN: 172.31.0.1/24 for IPv4, and for IPv6 the first /64 of whatever prefix the ISP delegates (see
# 20-wan6.network), with the router at ::1 in it. dnsmasq serves DHCPv4 and DNS, and sends the
# router advertisements that clients configure IPv6 from (SLAAC). There is no DHCPv6 on the LAN:
# hosts use SLAAC or a static address.
#
# Give hosts that need a fixed public address (e.g. for DNS records) the interface ID ::2 to ::9 in
# the LAN's /64 (see `ip -6 addr show dev lan`), with the router as gateway. SLAAC never picks
# these: its interface IDs are random or come from the MAC address.
[Match]
Name=lan

[Network]
Address=172.31.0.1/24
# Number lan from the prefix that wan6 gets (see [DHCPPrefixDelegation] below).
DHCPPrefixDelegation=yes
# dnsmasq advertises this router here; never take an address or a route from another one.
IPv6AcceptRA=no
# VLANs on lan: the guest networks (20 and 21), and the old rXg's network (10). See the .netdev
# files.
VLAN=guest4
VLAN=guest6
VLAN=rxg
# Configure lan even with no link, so boot doesn't wait for one (see RequiredForOnline= below).
# dnsmasq sends quick router advertisements only for a minute after it starts; if lan gets its
# link later, restart dnsmasq, or clients may wait up to 10 minutes for IPv6.
ConfigureWithoutCarrier=yes

[DHCPPrefixDelegation]
# The first /64 of the prefix, and ::1 in it.
SubnetId=0
Token=::1

[Link]
# Don't hold up boot without a LAN link; dnsmasq and nginx wait for network-online.target.
RequiredForOnline=no-carrier
