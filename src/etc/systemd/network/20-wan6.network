# IPv6 uplink (Comcast): take the default route from the ISP's router advertisements, and ask for
# a delegated prefix (DHCPv6-PD), so the ISP routes it here. IPv6 isn't NATed.
#
# Comcast's gateway routes both of my /56s (2603:300a:2161:ca00::/56 and cb00::/56) to itself, uses
# ca00::/64 for its own LAN (this link), and delegates a smaller prefix to routers behind it, e.g.
# cae0::/59. lan and guest6 take its first two /64s, whatever it is (see 20-lan.network and
# 20-guest6.network).
[Match]
Name=wan6

[Network]
DHCP=ipv6
IPv6AcceptRA=yes

[IPv6AcceptRA]
# Ask for a prefix even if the RA doesn't set the "managed" flag.
DHCPv6Client=always

[DHCPv6]
# Only a hint; the ISP decides the size.
PrefixDelegationHint=::/56
# Keep the prefix across reboots (RFC 9096), and keep our own hostname.
SendRelease=no
UseHostname=no

[Link]
# Don't hold up boot when the ISP is down; dnsmasq waits for network-online.target.
RequiredForOnline=no
